# ===== 메타 광고 세팅 자동화 - 환경설정 =====
# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 값을 채우세요.
# (.env 는 meta-ad-setup.hta 와 반드시 같은 폴더에 두세요)
# 주의: .env 에는 비밀정보가 들어갑니다. 외부 공유 / git 커밋 금지.

# 메타(페이스북) 광고 API
META_ACCESS_TOKEN=여기에_메타_액세스_토큰
META_PAGE_ID=여기에_페이지_ID

# 시놀로지 NAS (소재 폴더 접근 계정)
# UNC 경로(\\192.168.1.100\...)로 소재를 읽을 때 이 계정으로 자동 로그인합니다.
NAS_HOST=http://192.168.1.100:5000
NAS_ID=나스_계정
NAS_PW=나스_비밀번호
